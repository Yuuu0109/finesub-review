{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local review UI: API requests, user-selected downloads and external links.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*:*/api/*" },
        { "url": "http://localhost:*/api/*" },
        { "url": "http://127.0.0.1:*/api/*" }
      ]
    },
    "dialog:allow-save",
    "fs:allow-write-file",
    { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://*" }, { "url": "http://*" }] }
  ]
}
